# Somnia testnet (chain 50312)
NEXT_PUBLIC_CHAIN_ID=50312
NEXT_PUBLIC_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_DREAMDEX_REST=https://stg.api.dreamdex.io/v0
NEXT_PUBLIC_DREAMDEX_WS=wss://stg.api.dreamdex.io/v0/ws/public

# WalletConnect & Privy authentication
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Cloudflare Worker secrets (set via `wrangler secret put`)
# DREAMDEX_API_KEY=
# PRIVATE_KEY — generate a fresh signer key for the autocopy worker:
#   openssl rand -hex 32
# NEVER copy a real key into this file; set it via `wrangler secret put PRIVATE_KEY`.

# Cloudflare Worker env vars (set via `wrangler secret put` or wrangler.toml [vars]):
# Optional overrides for the indexer REST/WS URLs consumed by both
# indexer and autocopy workers. Unset = the testnet default is used.
# DREAMDEX_REST_URL=
# DREAMDEX_WS_URL=