# Somnia testnet (chain 50312)
NEXT_PUBLIC_CHAIN_ID=50312
NEXT_PUBLIC_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_DREAMDEX_REST=https://dev.smk.somnia.host/v1/graphql
NEXT_PUBLIC_DREAMDEX_WS=wss://api.infra.testnet.somnia.network/ws

# WalletConnect & Privy authentication
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Cloudflare Worker secrets (set via `wrangler secret put`)
# DREAMDEX_API_KEY=
# PRIVATE_KEY — generate a fresh signer key for the autocopy worker:
#   openssl rand -hex 32
# NEVER copy a real key into this file; set it via `wrangler secret put PRIVATE_KEY`.

# Cloudflare Worker env vars (set via `wrangler secret put` or wrangler.toml [vars]):
# Required indexer REST/WS URLs consumed by both indexer and autocopy workers.
# Missing values fail closed; no endpoint fallback is used.
# DREAMDEX_REST_URL=
# DREAMDEX_WS_URL=

# Durable persistence for Next.js on Vercel (session keys + follow rules).
# Local `next dev` can use gitignored `.data/session-keys.json` and
# `.data/follow-rules.json`. On Vercel serverless those file backends are
# NOT durable / often read-only — without one of these:
#   POST /api/auth-session-key → 503 SessionKeyPersistError
#   POST /api/follow-rules → 503 FollowRulesPersistError
# (never raw ENOENT from mkdir /var/task/.../.data).
#
# Prefer Upstash / Vercel KV (either pair works):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Or Cloudflare KV REST (reuse autocopy SESSION_KEYS_KV namespace id from
# apps/autocopy/wrangler.toml). Web keys do not collide:
#   web:session:{wallet}  — Settings session material
#   web:follow-rules:{wallet} — Auto-Follow rule lists
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_KV_NAMESPACE_ID=
# SESSION_KEYS_KV_NAMESPACE_ID=
