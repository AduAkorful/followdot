# Somnia Shannon testnet
DREAMDEX_REST_URL=https://dev.smk.somnia.host/v1/graphql
DREAMDEX_WS_URL=wss://api.infra.testnet.somnia.network/ws

# Secret: set locally or in the deployment provider, never commit a real key.
# PRIVATE_KEY=0x<64 hex characters>; set it through a secret manager, never commit it.
CHECK_ONLY=false

# Required risk policy
MAX_ORDER_USDC=1
MAX_DAILY_USDC=5
MIN_EXPIRY_SECONDS=120
STRATEGY_SIDE=BUY_YES
BOT_STATE_FILE=./.market-bot-state.json

# Optional discovery/risk filters
# ASSET=BTC
# INTERVAL_SECONDS=300
# MIN_LIQUIDITY_USDC=1
MAX_SPREAD_BPS=1000
RUN_ONCE=true
# Set CONTINUOUS=true and RUN_ONCE=false to keep trading while the process runs.
# CONTINUOUS=false
POLL_INTERVAL_MS=2000
FILL_TIMEOUT_MS=30000
